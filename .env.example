# AI-Powered Personal Health Copilot - Environment Configuration Example
# Copy this file to .env and supply genuine credentials for production/live deployments.

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-keep-secret-server-only
SUPABASE_STORAGE_BUCKET=medical-documents-private

# Sarvam AI OCR & Indian Language Provider Configuration
# Set to 'live' when SARVAM_API_KEY is supplied, otherwise fallback to 'mock'
SARVAM_PROVIDER_MODE=mock
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# AI Health Summary Provider (sarvam / openai / mock)
SUMMARY_MODEL_PROVIDER=mock
SUMMARY_MODEL_API_KEY=

# ABDM / ABHA Provider Configuration
# Supported options: 'mock' (visibly simulated sandbox workflow) or 'abdm' (official ABDM sandbox)
ABHA_PROVIDER=mock
ABDM_ENVIRONMENT=sandbox
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=

# Demo Synthetic Patient Preset
DEMO_PATIENT_ENABLED=true
DEMO_PATIENT_ID=00000000-0000-0000-0000-000000000001
DEMO_USER_ID=00000000-0000-0000-0000-000000000001
